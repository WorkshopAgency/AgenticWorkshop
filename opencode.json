{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["github:dskanakoglou/opencode-sidebar-plus#v0.3.0"],
  "compaction": {
    "auto": true,
    "buffer": 2048,
    "keep": { "tokens": 4096 }
  },
  "model": {
    "providerID": "opencode",
    "model": "big-pickle"
  },
  "providers": {
    "dtu": {
      "name": "DTU",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "models": {
        "qwen36": {
          "name": "Qwen 3.6 35B-A3B",
          "settings": {
            "baseURL": "https://teaching.healthtech.dtu.dk/workshop/qwen36"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen38": {
          "name": "Qwen 3.8 27B FP8",
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } }
          ],
          "settings": {
            "baseURL": "https://teaching.healthtech.dtu.dk/workshop/qwen38"
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "mistral": {
          "name": "Mistral Nemo 12B",
          "variants": [],
          "settings": {
            "baseURL": "https://teaching.healthtech.dtu.dk/workshop/mistral"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "gptoss": {
          "name": "GPT-OSS 20B",
          "settings": {
            "baseURL": "https://teaching.healthtech.dtu.dk/workshop/gptoss"
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "duckdb": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-server-motherduck@1.0.8",
          "--db-path",
          "exercises/03-mcp/data/workshop.duckdb",
          "--max-rows",
          "100",
          "--max-chars",
          "8000"
        ],
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "rcsb": {
        "type": "local",
        "command": [
          "uvx",
          "rcsb-mcp@0.15.0"
        ],
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "biomcp": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "biomcp-server==0.7.0",
          "bio-mcp"
        ],
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "opentargets": {
        "type": "remote",
        "url": "https://mcp.platform.opentargets.org/mcp",
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
