{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "buffer": 2048,
    "keep": { "tokens": 4096 }
  },
  "model": {
    "providerID": "dtu",
    "model": "qwen36"
  },
  "providers": {
    "dtu": {
      "name": "DTU",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "models": {
        "qwen36": {
          "name": "Qwenstorm (Qwen 3.6 35B-A3B)",
          "settings": {
            "baseURL": "https://teaching.healthtech.dtu.dk/workshop/qwen36"
          },
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "duckdb": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-server-motherduck@1.0.8",
          "--db-path",
          "exercises/04-mcp/data/workshop.duckdb",
          "--max-rows",
          "100",
          "--max-chars",
          "8000"
        ],
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "rcsb": {
        "type": "local",
        "command": [
          "uvx",
          "rcsb-mcp@0.15.0"
        ],
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "biomcp": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "biomcp-server==0.7.0",
          "bio-mcp"
        ],
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "opentargets": {
        "type": "remote",
        "url": "https://mcp.platform.opentargets.org/mcp",
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
